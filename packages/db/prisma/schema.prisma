// Multi-user schema (Supabase Auth users). Agent code supabase-js use karta hai;
// ye file documentation + future migrations ke liye hai.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserSetting {
  userId      String   @id @map("user_id") @db.Uuid
  ownerNumber String   @default("") @map("owner_number")
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@map("UserSetting")
}

model WaSession {
  userId    String   @id @map("user_id") @db.Uuid
  authBlob  Json?    @map("auth_blob")
  status    String   @default("disconnected")
  qr        String?
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("WaSession")
}

model Message {
  id         String   @id @default(cuid())
  userId     String   @map("user_id") @db.Uuid
  fromNumber String   @map("from_number")
  body       String
  reply      String?
  isOwner    Boolean  @default(false) @map("is_owner")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("Message")
}

model Reminder {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  title     String
  remindAt  DateTime @map("remind_at")
  sent      Boolean  @default(false)
  source    String   @default("custom")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, sent, remindAt])
  @@map("Reminder")
}

model Memory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  fact      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("Memory")
}
