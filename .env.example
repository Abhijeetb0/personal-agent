# Personal Agent — multi-user, 100% free stack.
# Secrets chat me mat bhejo — seedha .env / Render / Vercel dashboard me dalo.

# --- Supabase (Project Settings → Data API) ---
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...publishable...
SUPABASE_SECRET_KEY=eyJ...secret... (sirf agent backend me, web me MAT dalo)
DATABASE_URL=postgresql://postgres:DB_PASSWORD@db.xyzcompany.supabase.co:5432/postgres

# --- AI (dono free; Groq primary, Gemini fallback) ---
GROQ_API_KEY=gsk_...
# GROQ_MODELS priority order me (comma-separated). 429 aate hi agle model pe turant failover.
# Purana GROQ_MODEL (single) bhi chalega. Khali chhoda to built-in default list chalegi.
GROQ_MODELS=groq/compound-mini,llama-3.3-70b-versatile,llama-3.1-8b-instant
GEMINI_API_KEY=AIza...
AI_ORDER=groq,gemini

# --- Agent (Render) ---
# OWNER_NUMBER sirf local dev fallback hai; production me har user dashboard se set karta hai
OWNER_NUMBER=91XXXXXXXXXX
PORT=3001
# Local dev me bina login test karna ho to: ALLOW_NO_AUTH=1 (production me MAT lagana)

# --- Web (Vercel) ---
AGENT_BASE_URL=https://tumhara-agent.onrender.com
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...publishable...
