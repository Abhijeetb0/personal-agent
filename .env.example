# Tumhe jo 3 cheez banani thi, unko yaha bharna hai.
# Ye file kabhi git me PUSH mat karna. Sirf apne PC / Render / Vercel dashboard me bhardo.

# --- Supabase (Dashboard → Project Settings → Data API) ---
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...publishable...w
SUPABASE_SECRET_KEY=eyJ...secret... (sirf agent backend me, web me MAT dalo)
DATABASE_URL=postgresql://postgres:DB_PASSWORD@db.xyzcompany.supabase.co:5432/postgres

# --- Gemini (aistudio.google.com se) ---
GEMINI_API_KEY=AIza...

# --- Groq (console.groq.com — free, generous limits; primary AI) ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=groq/compound-mini
# AI try order (comma-separated): groq pehle, fir gemini
AI_ORDER=groq,gemini

# --- Agent ---
# Owner = tumhara number (jis se tum message karoge). Agent sirf isi ko reply karega.
OWNER_NUMBER=917761815151
# Agent = wo SIM jispe agent chalega (QR/code isi se link hoga). Poora number, bina + ke.
AGENT_NUMBER=91XXXXXXXXXX
# Web dashboard ka simple password (single-user login)
DASHBOARD_PASSWORD=badal-do-isse
# Web se agent ko allow karne ke liye secret (dono jagah same رکھنا)
AGENT_API_SECRET=koi-lambi-random-string
PORT=3001

# --- Web (Vercel me) ---
AGENT_BASE_URL=http://localhost:3001
NEXT_PUBLIC_AGENT_BASE_URL=http://localhost:3001
